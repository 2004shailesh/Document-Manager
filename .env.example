# ==============================================================================
# Document Management System - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development or configure these variables
# in your cloud provider settings (e.g. Render Dashboard / Neon / Supabase).
# ==============================================================================

# 1. Database Configuration (Preferred: DATABASE_URL)
# Cloud PostgreSQL connection string (Render, Neon, Supabase):
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# Fallback individual database parameters for local development:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_password_here
DB_NAME=Document

# 2. Server & Environment Configuration
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 3. CORS Configuration (Comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# 4. File Upload Limits
MAX_FILE_SIZE_MB=3
